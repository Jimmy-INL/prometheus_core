# Include documentation
include README.md
include QUICK_START.md
include IMPLEMENTATION_SUMMARY.md
include ENV_SETUP.md
include TESTING.md
include LICENSE

# Include configuration files
include requirements.txt
include .env.example
include pytest.ini

# Include the package
recursive-include storage_client *.py

# Exclude test and development files from distribution
exclude test_*.py
exclude debug_*.py
exclude list_datasources.py
exclude verify_installation.py
recursive-exclude tests *
recursive-exclude examples *

# Exclude build artifacts
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude *$py.class
global-exclude *.so
global-exclude .DS_Store
