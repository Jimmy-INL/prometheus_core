# =============================================================================
# Prometheus Platform — Environment Variables
# Copy this file and fill in your real secrets.
# Source it before starting: source env/prometheus.env
# =============================================================================

# --- Secrets -----------------------------------------------------------------
export LITELLM_DB_PASSWORD="changeme_db_password"
export LITELLM_MASTER_KEY="sk-changeme_litellm_key"
export REDIS_PASSWORD="changeme_redis_password"
export AGENT_SECRET="changeme_agent_secret"
export CHAINLIT_AUTH_SECRET="changeme_chainlit_secret"
export ANTHROPIC_API_KEY="sk-ant-changeme"

# --- Model -------------------------------------------------------------------
export MODEL_NAME="${MODEL_NAME:-claude-sonnet-4-20250514}"

# --- Ports -------------------------------------------------------------------
export PORT_LITELLM_DB=5432
export PORT_REDIS=6379
export PORT_LITELLM=4000
export PORT_CLIENT_AGENT=8000
export PORT_CHAINLIT=8500
export PORT_CORROSION_AGENT=8002
export PORT_RADIATION_AGENT=8003
export PORT_THERMAL_AGENT=8004
export PORT_DATA_AGENT=8005
export PORT_FORM_FILLER_AGENT=8006
export PORT_OSTI_RESEARCH_AGENT=8007
export PORT_ARTIFACT_DEBUG_AGENT=8008
export PORT_SYNTHESIS_AGENT=8009

# --- URLs (derived from ports above) ----------------------------------------
export REDIS_URL="redis://localhost:${PORT_REDIS}"
export LITELLM_URL="http://localhost:${PORT_LITELLM}"
export CLIENT_AGENT_URL="http://localhost:${PORT_CLIENT_AGENT}"

# --- Agent secret enforcement ------------------------------------------------
export AGENT_SECRET_REQUIRED="${AGENT_SECRET_REQUIRED:-false}"

# --- Data / cache directories ------------------------------------------------
# These will be bind-mounted into the containers.
export PROMETHEUS_DATA_DIR="${HOME}/prometheus-data"
export PGDATA_DIR="${PROMETHEUS_DATA_DIR}/pgdata"
export PGRUN_DIR="${PROMETHEUS_DATA_DIR}/pgrun"
export REDIS_DATA_DIR="${PROMETHEUS_DATA_DIR}/redis-data"
export SHARED_DIR="${PROMETHEUS_DATA_DIR}/shared"
export OSTI_MODEL_CACHE="${PROMETHEUS_DATA_DIR}/osti-model-cache"
export HF_CACHE="${PROMETHEUS_DATA_DIR}/huggingface-cache"
export TORCH_CACHE="${PROMETHEUS_DATA_DIR}/torch-cache"
export FRONTEND_DATA_DIR="${PROMETHEUS_DATA_DIR}/frontend"
export LITELLM_PRISMA="${PROMETHEUS_DATA_DIR}/litellm_prisma"
export LITELLM_NPM="${PROMETHEUS_DATA_DIR}/litellm_npm"
export LITELLM_MIGRATIONS="${PROMETHEUS_DATA_DIR}/litellm_migrations"

# --- Certificate bundle (set to your corp CA bundle if behind a proxy) -------
export CA_BUNDLE="/etc/ssl/certs/ca-bundle.pem"

