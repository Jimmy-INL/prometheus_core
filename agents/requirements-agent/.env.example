# Agent Configuration
AGENT_PORT=8000  # Internal port the agent listens on (required for agent card URL)
# AGENT_HOST=localhost  # Hostname for agent card URL (use Docker service name for inter-agent communication)
REGISTRY_URL=http://registry:8000

# Security: Shared Secret Authentication
# REQUIRED in production/multi-user environments
# All agents in your deployment must use the same secret
# Generate a strong secret with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_SECRET=

# Optional: Disable authentication (DEVELOPMENT ONLY - NOT RECOMMENDED)
# Set to 'false' to disable authentication when AGENT_SECRET is not set
# AGENT_SECRET_REQUIRED=true

# Proxy Configuration (if needed)
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1

# SSL Configuration (if needed)
# SSL_CERT_FILE=/etc/ssl/certs/ca-bundle.pem
# REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-bundle.pem

# LLM Configuration (optional - enables natural language spec parsing)
# At least one API key enables LLM-assisted parsing; fallback is regex-only
# Priority order: Anthropic → OpenAI → regex-only

# Option 1: Anthropic (preferred)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Option 2: OpenAI (alternative)
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# nucsys_agent resource overrides (normally not needed; package resources are used)
# NUCSYS_ONTOLOGY_PATH=/path/to/custom/ontology.yaml
# NUCSYS_CARDS_DIR=/path/to/custom/cards/

# StorageClient config (if using DeepLynx storage integration)
# Required: API Authentication — use either API key/secret OR JWT token (not both)

# Option 1: API Key Authentication (recommended)
# DEEPLYNX_KEY=your-api-key-here
# DEEPLYNX_SECRET=your-api-secret-here

# Option 2: JWT Token Authentication (alternative)
# DEEPLYNX_JWT_TOKEN=your-jwt-token-here

# Required: Organization and Project IDs
# DEEPLYNX_ORG_ID=123
# DEEPLYNX_PROJECT_ID=456

# Optional but recommended: Data Source ID (required for creating records)
# DEEPLYNX_DATA_SOURCE_ID=789

# Optional: Custom Base URL (defaults to INL DeepLynx instance)
# DEEPLYNX_BASE_URL=https://deeplynx.inl.gov/api/v1
