# Prometheus Platform - Environment Variables
# Copy this file to .env and fill in the values. 
# You can use the following command to quickly generate keys
# python3 -c "import secrets; print(secrets.token_hex(32))"

# --- Required ---

# Provider credential used by the bundled LiteLLM proxy and the Anthropic
# direct profile
ANTHROPIC_API_KEY=sk-ant-...

# Shared secret for inter-agent A2A authentication
AGENT_SECRET=change-me-to-a-random-string

# Valkey password (Redis-compatible protocol)
REDIS_PASSWORD=change-me-to-a-random-password

# Redis-compatible Valkey connection URL (used by agents and frontend)
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# Chainlit session encryption secret
CHAINLIT_AUTH_SECRET=change-me-to-a-random-string

# Litellm
LITELLM_MASTER_KEY=change-me-to-a-random-string
LITELLM_DB_PASSWORD=change-me-to-a-random-string

# --- Optional ---

# Prometheus API base image hash used by agent builds. Keep in sync with the
# Makefile default unless you are intentionally testing a different base image.
#PROMETHEUS_API_BASE_IMAGE_HASH=

# Include the nested debug agents under agents/debug-agents/* in the generated
# docker-compose.agents.yml. Set to "true" to include them. Default: false.
DEBUG_AGENTS=false

# LLM configuration used by the agents in this Compose deployment. Independently
# deployed agents can set these variables and provider keys in their own environment.
# LLM_CONFIG_FILE overrides LLM_CONFIG_PROFILE and must exist inside the container.
LLM_CONFIG_PROFILE=registry
LLM_CONFIG_FILE=

# Direct-provider credentials. Only the keys referenced by the selected profile
# are required. The Anthropic profile uses EMBEDDING_API_KEY for embeddings.
EMBEDDING_API_KEY=
OPENAI_API_KEY=
INL_HPC_API_KEY=
INL_LITELLM_API_KEY=
AMSC_I2_API_KEY=

# Max upload size in bytes for frontend and client-agent staging (default: 100 MiB)
PROMETHEUS_MAX_UPLOAD_BYTES=104857600

# Whether agent secret is required for specialist agents (default: true)
# AGENT_SECRET_REQUIRED=true

# Corporate proxy settings (if behind a proxy)
# HTTP_PROXY=http://proxy:8080
# HTTPS_PROXY=http://proxy:8080
# NO_PROXY=localhost,127.0.0.1,litellm,litellm-db,redis,client-agent

# DeepLynx storage credentials (required for artifact-debug-agent and deeplynx:// URI resolution)
# See prometheus_api/docs/ENV_SETUP.md for details.
# DEEPLYNX_BASE_URL=https://deeplynx.inl.gov/api/v1
# DEEPLYNX_KEY=your-api-key
# DEEPLYNX_SECRET=your-api-secret
# DEEPLYNX_ORG_ID=1
# DEEPLYNX_PROJECT_ID=1

LITELLM_LOCAL_PORT=9977
REDIS_LOCAL_PORT=6379
# FRONTEND_URL=

CLIENT_AGENT_URL=http://client-agent:8000
CLIENT_AGENT_PORT=8001
CHAINLIT_FRONTEND_PORT=8500

# Standalone FastAPI chat backend (chat-backend/) — replaces Chainlit's server role
CHAT_BACKEND_PORT=8600
# Session-cookie signing secret. If left blank, the chat-backend falls back to
# CHAINLIT_AUTH_SECRET (set above); one of the two MUST be non-empty or the backend
# refuses to start. Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
CHAT_BACKEND_JWT_SECRET=

OAUTH_OKTA_CLIENT_ID=""
OAUTH_OKTA_CLIENT_SECRET=""
OAUTH_OKTA_DOMAIN="identity-preview.inl.gov"
OAUTH_OKTA_AUTHORIZATION_SERVER_ID=false
CHAINLIT_URL=""
