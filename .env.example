# Prometheus Platform - Environment Variables
# Copy this file to .env and fill in the values

# --- Required ---

# Anthropic API key for Claude (used by all agents)
ANTHROPIC_API_KEY=sk-ant-...

# Shared secret for inter-agent A2A authentication
AGENT_SECRET=change-me-to-a-random-string

# Redis password
REDIS_PASSWORD=change-me-to-a-random-password

# Redis connection URL (used by agents and frontend)
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# Chainlit session encryption secret
CHAINLIT_AUTH_SECRET=change-me-to-a-random-string

# --- Optional ---

# Claude model name (default: claude-sonnet-4-20250514)
# MODEL_NAME=claude-sonnet-4-20250514

# Whether agent secret is required for specialist agents (default: true)
# AGENT_SECRET_REQUIRED=true

# Corporate proxy settings (if behind a proxy)
# HTTP_PROXY=http://proxy:8080
# HTTPS_PROXY=http://proxy:8080
# NO_PROXY=localhost,127.0.0.1,registry,redis,client-agent

# Custom CA certificate directory (for corporate CAs)
# CA_CERT_DIR=./certs

# Artifact debug agent public URL (for browser-accessible artifact downloads)
# ARTIFACT_DEBUG_PUBLIC_URL=http://localhost:8008
