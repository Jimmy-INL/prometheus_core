# DeepLynx API Configuration
# Copy this file to .env and fill in your credentials
# The .env file is gitignored and will not be committed

# Required: API Authentication
# Use either API key/secret OR JWT token (not both)

# Option 1: API Key Authentication (recommended)
DEEPLYNX_KEY=your-api-key-here
DEEPLYNX_SECRET=your-api-secret-here

# Option 2: JWT Token Authentication (alternative)
# DEEPLYNX_JWT_TOKEN=your-jwt-token-here

# Required: Organization and Project IDs
DEEPLYNX_ORG_ID=123
DEEPLYNX_PROJECT_ID=456

# Optional but recommended: Data Source ID (required for creating records)
# DEEPLYNX_DATA_SOURCE_ID=789

# Optional: Custom Base URL (defaults to INL DeepLynx instance)
# DEEPLYNX_BASE_URL=https://deeplynx.inl.gov/api/v1

# Optional: Connection Settings (uncomment to customize)
# DEEPLYNX_TIMEOUT=30.0
# DEEPLYNX_MAX_RETRIES=3
# DEEPLYNX_VERIFY_SSL=true
